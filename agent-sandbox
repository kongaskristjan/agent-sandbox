#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BASE_COMPOSE="$SCRIPT_DIR/docker-compose.yml"
export HOST_UID="$(id -u)"

usage() {
    echo "Usage: agent-sandbox [--gpu|--rust] [--host-network] [--update] [--agents|--opencode|--codex] [--api-keys] [--port <port>] [project-dir]"
    echo ""
    echo "Options:"
    echo "  --gpu           Use the CUDA image with NVIDIA GPU passthrough"
    echo "                  (default: CPU-only ubuntu:24.04 image)"
    echo "  --rust          Use the Rust image (rustup toolchain, no Python or"
    echo "                  CUDA) with persistent cargo registry and build caches"
    echo "  --host-network  Use host networking (always enabled for rootless Docker,"
    echo "                  opt-in for rootful Docker)"
    echo "  --update        Refresh the agent binaries in the image (other layers"
    echo "                  stay cached); future runs reuse the refreshed layer"
    echo "  --agents        Launch the background-agents view ('claude agents')"
    echo "                  instead of an interactive session"
    echo "  --opencode      Run opencode instead of Claude Code (same image; the"
    echo "                  agent is selected at runtime, not baked into one)"
    echo "  --codex         Run Codex using your host ChatGPT login and setup"
    echo "  --api-keys      Also forward stored API keys and ANTHROPIC_API_KEY /"
    echo "                  OPENAI_API_KEY (disabled by default)"
    echo "  --port <port>   (--opencode only) Point opencode at an OpenAI-compatible"
    echo "                  server running on the host at this port; auto-enables"
    echo "                  host networking and auto-discovers its models"
    echo ""
    echo "Environment variables:"
    echo "  AGENT_SANDBOX_MODE=rootless|rootful   Override Docker mode auto-detection"
    echo "  ANTHROPIC_API_KEY=sk-ant-...          API key (requires --api-keys)"
    echo "  OPENAI_API_KEY=sk-...                API key (requires --api-keys)"
    echo "  CODEX_HOME                          Host Codex directory (default ~/.codex)"
    echo "  OPENCODE_API_HOST=127.0.0.1          Host address --port targets (opencode)"
    exit 0
}

GPU=false
RUST=false
HOST_NETWORK=false
UPDATE=false
AGENTS=false
OPENCODE=false
CODEX=false
API_KEYS=false
PORT=""
PROJECT_DIR=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --gpu) GPU=true ;;
        --rust) RUST=true ;;
        --host-network) HOST_NETWORK=true ;;
        --update) UPDATE=true ;;
        --agents) AGENTS=true ;;
        --opencode) OPENCODE=true ;;
        --codex) CODEX=true ;;
        --api-keys) API_KEYS=true ;;
        --port)
            if [ "$#" -lt 2 ]; then
                echo "Error: --port requires a port number." >&2
                exit 1
            fi
            PORT="$2"
            shift
            ;;
        --help|-h) usage ;;
        *) PROJECT_DIR="$1" ;;
    esac
    shift
done

if [ "$GPU" = true ] && [ "$RUST" = true ]; then
    echo "Error: --gpu and --rust select different images; pick one." >&2
    exit 1
fi

if [ "$OPENCODE" = true ] && [ "$AGENTS" = true ]; then
    echo "Error: --opencode and --agents select different agents; pick one." >&2
    exit 1
fi

if [ "$CODEX" = true ] && { [ "$OPENCODE" = true ] || [ "$AGENTS" = true ]; }; then
    echo "Error: --codex cannot be combined with --opencode or --agents." >&2
    exit 1
fi

if [ -n "$PORT" ]; then
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
        echo "Error: --port must be a number between 1 and 65535 (got: $PORT)." >&2
        exit 1
    fi
    if [ "$OPENCODE" != true ]; then
        echo "Error: --port only applies to --opencode." >&2
        exit 1
    fi
fi

export PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"

# Which agent the entrypoint launches. Orthogonal to the image: every agent is
# installed in every image and picked at runtime, so it composes with
# --rust/--gpu/--host-network.
if [ "$OPENCODE" = true ]; then
    export SANDBOX_AGENT="opencode"
elif [ "$CODEX" = true ]; then
    export SANDBOX_AGENT="codex"
else
    export SANDBOX_AGENT="claude"
fi

# Port of a host OpenAI-compatible server (--port); empty unless --port is
# given. The entrypoint uses it (opencode only) to point opencode at
# http://127.0.0.1:<port>/v1 over host networking, where 127.0.0.1 is the host.
export OPENCODE_API_PORT="${PORT:-}"
export OPENCODE_API_HOST="${OPENCODE_API_HOST:-127.0.0.1}"

# Stage only the selected agent's credentials in private, read-only mounts.
# Filtering must happen on the host: filtering after mounting would still
# expose the original API keys to processes inside the sandbox.
AUTH_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agent-sandbox-auth.XXXXXX")"
trap 'rm -rf "$AUTH_DIR"' EXIT
export CLAUDE_CREDENTIALS_FILE="$AUTH_DIR/claude-credentials.json"
export CLAUDE_CONFIG_FILE="$AUTH_DIR/claude.json"
export OPENCODE_AUTH_FILE="$AUTH_DIR/opencode-auth.json"
export OPENCODE_CONFIG_FILE="$AUTH_DIR/opencode.json"
export CODEX_AUTH_FILE="$AUTH_DIR/codex-auth.json"
export CODEX_SETUP_DIR="$AUTH_DIR/codex-setup"
mkdir -m 700 "$CODEX_SETUP_DIR"
export SANDBOX_API_KEYS="$API_KEYS"
export SANDBOX_ANTHROPIC_API_KEY=""
export SANDBOX_OPENAI_API_KEY=""
if [ "$API_KEYS" = true ]; then
    export SANDBOX_ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
    export SANDBOX_OPENAI_API_KEY="${OPENAI_API_KEY:-}"
fi
for f in "$CLAUDE_CREDENTIALS_FILE" "$CLAUDE_CONFIG_FILE" "$OPENCODE_AUTH_FILE" \
         "$OPENCODE_CONFIG_FILE" "$CODEX_AUTH_FILE"; do
    touch "$f"
    chmod 600 "$f"
done

stage_auth() {
    python3 "$SCRIPT_DIR/prepare-auth.py" "$1" "$2" "$3" "$API_KEYS"
}

if [ "$CODEX" = true ]; then
    stage_auth codex "${CODEX_HOME:-$HOME/.codex}/auth.json" "$CODEX_AUTH_FILE"
    stage_auth codex-setup "${CODEX_HOME:-$HOME/.codex}" "$CODEX_SETUP_DIR/codex"
    if [ -d "$HOME/.agents/skills" ]; then
        mkdir -p "$CODEX_SETUP_DIR/agents"
        cp -RLp "$HOME/.agents/skills" "$CODEX_SETUP_DIR/agents/skills"
    fi
    if [ ! -s "$CODEX_AUTH_FILE" ] && [ -z "$SANDBOX_OPENAI_API_KEY" ]; then
        echo "Warning: no host Codex ChatGPT login found; using any existing sandbox login."
        echo "To forward a host login, run: codex -c 'cli_auth_credentials_store=\"file\"' login"
        echo "API-key authentication requires --api-keys."
    fi
elif [ "$OPENCODE" = true ]; then
    stage_auth opencode "$HOME/.local/share/opencode/auth.json" "$OPENCODE_AUTH_FILE"
    stage_auth config "$HOME/.config/opencode/opencode.json" "$OPENCODE_CONFIG_FILE"
    if [ ! -s "$OPENCODE_AUTH_FILE" ] && [ -z "$SANDBOX_ANTHROPIC_API_KEY$SANDBOX_OPENAI_API_KEY" ]; then
        echo "Warning: no opencode host login found. Log in interactively or use --api-keys."
    fi
else
    CLAUDE_AUTH_SOURCE="$HOME/.claude/.credentials.json"
    if [ "$(uname -s)" = "Darwin" ] && [ -z "$SANDBOX_ANTHROPIC_API_KEY" ]; then
        KEYCHAIN_CREDS="$AUTH_DIR/keychain.json"
        if (umask 077; security find-generic-password -s "Claude Code-credentials" -w \
            > "$KEYCHAIN_CREDS" 2>/dev/null) && [ -s "$KEYCHAIN_CREDS" ]; then
            CLAUDE_AUTH_SOURCE="$KEYCHAIN_CREDS"
        fi
    fi
    stage_auth claude "$CLAUDE_AUTH_SOURCE" "$CLAUDE_CREDENTIALS_FILE"
    stage_auth config "$HOME/.claude.json" "$CLAUDE_CONFIG_FILE"
    if [ "$API_KEYS" = true ] && [ -z "$SANDBOX_ANTHROPIC_API_KEY" ] && [ ! -s "$CLAUDE_CREDENTIALS_FILE" ]; then
        # Legacy Claude API billing config is only consulted with explicit opt-in.
        SANDBOX_ANTHROPIC_API_KEY="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("primaryApiKey", ""))' \
            "$HOME/.claude/config.json" 2>/dev/null || true)"
        export SANDBOX_ANTHROPIC_API_KEY
    fi
    if [ -z "$SANDBOX_ANTHROPIC_API_KEY" ] && [ ! -s "$CLAUDE_CREDENTIALS_FILE" ]; then
        echo "Error: no Claude subscription login found."
        echo "Run 'claude' on the host to log in, or use --api-keys to forward API billing credentials."
        exit 1
    fi
fi

# Optional non-auth bind mounts still need host placeholders.
for f in "$HOME/.gitconfig" "$HOME/.config/pulse/cookie"; do
    if [ ! -f "$f" ]; then
        mkdir -p "$(dirname "$f")"
        touch "$f"
    fi
done

# Same for the host skills directory, which is bind-mounted into the container's
# config volume. Create it ourselves rather than letting Docker do it — under
# rootful Docker the daemon would create it owned by root.
mkdir -p "$HOME/.claude/skills"

# Detect rootless vs rootful Docker
detect_docker_mode() {
    if [ -n "${AGENT_SANDBOX_MODE:-}" ]; then
        case "$AGENT_SANDBOX_MODE" in
            rootless|rootful) echo "$AGENT_SANDBOX_MODE"; return ;;
            *) echo "Error: AGENT_SANDBOX_MODE must be 'rootless' or 'rootful'" >&2; exit 1 ;;
        esac
    fi

    if [ -S "/run/user/$HOST_UID/docker.sock" ]; then
        echo "rootless"
        return
    fi

    local docker_root
    docker_root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)"
    if [[ "$docker_root" == "$HOME"* ]]; then
        echo "rootless"
        return
    fi

    echo "rootful"
}

MODE="$(detect_docker_mode)"
OVERRIDE_COMPOSE="$SCRIPT_DIR/docker-compose.${MODE}.yml"

# --port reaches a service on the host, which the container can only do over
# host networking (127.0.0.1). Rootless already has host networking; opt
# rootful runs in too so the flag behaves the same in both modes.
if [ -n "$PORT" ] && [ "$MODE" = "rootful" ]; then
    HOST_NETWORK=true
fi

# Build compose file list
COMPOSE_FILES=(-f "$BASE_COMPOSE" -f "$OVERRIDE_COMPOSE")

if [ "$GPU" = true ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.gpu.yml")
fi

if [ "$RUST" = true ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.rust.yml")
fi

# Add host networking override if requested (meaningful for rootful; rootless already has it)
STATUS="$MODE"
[ "$GPU" = true ] && STATUS="$STATUS, gpu"
[ "$RUST" = true ] && STATUS="$STATUS, rust"
if [ "$HOST_NETWORK" = true ] && [ "$MODE" = "rootful" ]; then
    COMPOSE_FILES+=(-f "$SCRIPT_DIR/docker-compose.host-network.yml")
    STATUS="$STATUS, host networking"
fi
echo "Docker mode: $STATUS"

# --update bumps a stamp fed to AGENT_CACHE_BUST, which rebuilds the agent
# layers. It is passed on every build: with a one-off value the next plain
# build would match the stale layers again.
STAMP_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/agent-sandbox/update-stamp"
if [ "$UPDATE" = true ]; then
    mkdir -p "$(dirname "$STAMP_FILE")"
    date +%s > "$STAMP_FILE"
fi
BUILD_ARGS=(--build-arg "AGENT_CACHE_BUST=$(cat "$STAMP_FILE" 2>/dev/null || echo 0)")
if [ "$UPDATE" = false ]; then
    BUILD_ARGS+=(--quiet)
fi

# Override the default command to launch a specific agent/view. opencode runs
# in the compose working_dir (/workspace/project), so it takes no project arg.
RUN_ARGS=()
if [ "$OPENCODE" = true ]; then
    RUN_ARGS=(opencode --auto)
elif [ "$CODEX" = true ]; then
    RUN_ARGS=(codex --dangerously-bypass-approvals-and-sandbox -c 'cli_auth_credentials_store="file"' -c 'projects."/workspace/project".trust_level="trusted"')
elif [ "$AGENTS" = true ]; then
    RUN_ARGS=(claude agents --dangerously-skip-permissions)
fi

docker compose "${COMPOSE_FILES[@]}" build "${BUILD_ARGS[@]}"
docker compose "${COMPOSE_FILES[@]}" run --rm agent-dev ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}
