FROM ubuntu:24.04

# Install steps live in docker/. Each script is copied right before its RUN so
# editing one only rebuilds from that layer on.
ARG SCRIPTS=/usr/local/lib/claude-sandbox/build

COPY docker/apt-base.sh $SCRIPTS/
RUN bash $SCRIPTS/apt-base.sh pkg-config libssl-dev

RUN useradd -m -s /bin/bash -G root,audio dev

COPY docker/node.sh $SCRIPTS/
RUN bash $SCRIPTS/node.sh

# Rust toolchain, installed into dev's home rather than /usr/local so the
# sandbox user owns it and can `rustup update` / `cargo install` at runtime.
# Only the cache subdirectories of CARGO_HOME are named volumes (registry, git,
# target — see docker-compose.rust.yml), so the toolchain and the rustup shims
# in ~/.cargo/bin are never masked by a stale volume.
#
# CARGO_TARGET_DIR moves build output off the bind-mounted project directory
# into that volume: it persists across runs like the uv cache does, it can't
# collide with a `target/` the host built with a different toolchain, and cargo
# reuses identical dependency builds across every project mounted into the
# sandbox.
ENV RUSTUP_HOME=/home/dev/.rustup \
    CARGO_HOME=/home/dev/.cargo \
    CARGO_TARGET_DIR=/home/dev/.cargo/target \
    PATH=/home/dev/.cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal \
        --default-toolchain stable --component rustfmt --component clippy \
    && chown -R dev:dev /home/dev/.rustup /home/dev/.cargo

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    PLAYWRIGHT_CLI_VERSION=0.1.22 \
    NO_UPDATE_NOTIFIER=1
COPY docker/playwright-cli.sh $SCRIPTS/
RUN bash $SCRIPTS/playwright-cli.sh

# Agent layers last, so --update (AGENT_CACHE_BUST) only rebuilds these; see
# Dockerfile.
ARG AGENT_CACHE_BUST=0
COPY docker/claude.sh $SCRIPTS/
RUN bash $SCRIPTS/claude.sh

COPY docker/opencode.sh $SCRIPTS/
RUN bash $SCRIPTS/opencode.sh

RUN npm install -g @openai/codex

COPY prepare-auth.py /usr/local/lib/claude-sandbox/prepare-auth.py
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude", "--dangerously-skip-permissions"]
